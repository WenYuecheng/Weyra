# Public allowlist: application source and installation/documentation assets.
# Other files remain local, including private research and evaluation material.
/*
!/.gitignore
!/.env.example
!/README.md
!/LICENSE
!/THIRD_PARTY_NOTICES.md
!/MANIFEST.in
!/pyproject.toml
!/requirements.txt
!/weyra.example.toml
!/weyra/
!/.github/
!/docs/
!/examples/
!/scripts/
!/tests/
!/benchmarks/

/benchmarks/*
!/benchmarks/README.md
!/benchmarks/polyglot/
/benchmarks/polyglot/*
!/benchmarks/polyglot/policy.py
!/benchmarks/polyglot/protocol.json
!/benchmarks/polyglot/report.py
!/benchmarks/polyglot/results.csv
!/benchmarks/reliability/
/benchmarks/reliability/*
!/benchmarks/reliability/run_suite.py
!/benchmarks/skills_eval/
/benchmarks/skills_eval/*
!/benchmarks/skills_eval/run_benchmark.py

/.github/*
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/ci.yml
/docs/*
!/docs/skill-evolution.md
!/docs/screenshots/
/docs/screenshots/*
!/docs/screenshots/*.png
/tests/*
!/tests/test_*.py
/examples/*
!/examples/sdk_service.py
!/examples/demo_tui.py
!/examples/file_workflow.py
!/examples/project_analysis.py
!/examples/personalized_writing.py
/scripts/*
!/scripts/verify_source.py
!/scripts/capture_readme.py

# Only Python source and the terminal stylesheet may enter the runtime tree.
/weyra/**/*
!/weyra/**/
!/weyra/**/*.py
!/weyra/**/*.tcss

# Optional local evaluation modules.
/weyra/_benchmark_compat.py
/weyra/evaluation.py
/weyra/core_context.py
/weyra/core_corpus.py
/weyra/core_evaluation.py
/weyra/core_scoring.py
/weyra/final_campaign_report.py
/weyra/final_delivery_eval.py
/weyra/final_legacy_eval.py
/weyra/final_skill_eval.py
/weyra/finish_context_eval.py
/weyra/finish_evaluation.py

__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.weyra/
.env
.env.*
!.env.example
*.db
*.db-*
*.sqlite
*.sqlite3
*.log
.DS_Store
