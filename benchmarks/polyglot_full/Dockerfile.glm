# Python and JavaScript use the established Weyra image. The other adapters
# inherit its read-only worker and have independent toolchain images.
ARG BASE=weyra-polyglot:20261023
FROM ${BASE} AS go
USER root
ARG TARGETARCH
RUN apt-get update && apt-get install -y --no-install-recommends curl ca-certificates && rm -rf /var/lib/apt/lists/*
RUN case "${TARGETARCH}" in \
      arm64) sum=9aa1243d51d41e2f93e895c89c0a2daf7166768c4a4c3ac79db81029d295a540 ;; \
      amd64) sum=5b7899591c2dd6e9da1809fde4a2fad842c45d3f6b9deb235ba82216e31e34a6 ;; \
      *) exit 1 ;; \
    esac && curl -fsSL --retry 3 "https://dl.google.com/go/go1.24.9.linux-${TARGETARCH}.tar.gz" -o /tmp/go.tar.gz && \
    echo "$sum  /tmp/go.tar.gz" | sha256sum -c - && tar -xzf /tmp/go.tar.gz -C /usr/local && rm /tmp/go.tar.gz
ENV PATH="/usr/local/go/bin:${PATH}"
ENV GOCACHE=/tmp/go-build GOPATH=/tmp/go GOTOOLCHAIN=local GOPROXY=off
USER 1000:1000

FROM ${BASE} AS cpp
USER root
RUN apt-get update && apt-get install -y --no-install-recommends g++ cmake make libboost-date-time-dev libtbb-dev && rm -rf /var/lib/apt/lists/*
USER 1000:1000

FROM ${BASE} AS java
USER root
RUN apt-get update && apt-get install -y --no-install-recommends openjdk-17-jdk-headless curl ca-certificates && rm -rf /var/lib/apt/lists/*
RUN mkdir /opt/java-libs && cd /opt/java-libs && \
    for artifact in \
      org/junit/platform/junit-platform-console-standalone/1.10.0/junit-platform-console-standalone-1.10.0 \
      org/assertj/assertj-core/3.25.1/assertj-core-3.25.1 \
      org/json/json/20190722/json-20190722 \
      io/reactivex/rxjava2/rxjava/2.2.12/rxjava-2.2.12 \
      org/reactivestreams/reactive-streams/1.0.2/reactive-streams-1.0.2; \
    do curl -fsSLo "${artifact##*/}.jar" "https://repo.maven.apache.org/maven2/$artifact.jar" || exit 1; done
USER 1000:1000

FROM public.ecr.aws/docker/library/rust:1.91-bookworm AS rust-toolchain
WORKDIR /opt/weyra-cargo-seed
RUN cargo init --lib --name w_fixture . && \
    cargo add rand@0.8 time@0.3 anyhow@1 itertools@0.13 permutohedron@0.2 num-bigint@0.4 num-traits@0.2 thiserror@1 regex@1 counter@0.5 && \
    cargo fetch && chmod -R a+rX /usr/local/cargo

FROM ${BASE} AS rust
USER root
RUN apt-get update && apt-get install -y --no-install-recommends gcc libc6-dev && rm -rf /var/lib/apt/lists/*
COPY --from=rust-toolchain /usr/local/cargo /opt/rust/cargo
COPY --from=rust-toolchain /usr/local/rustup /opt/rust/rustup
COPY --from=rust-toolchain /opt/weyra-cargo-seed/Cargo.lock /opt/rust/dependencies.lock
ENV PATH="/opt/rust/cargo/bin:${PATH}" RUSTUP_HOME=/opt/rust/rustup CARGO_HOME=/tmp/cargo
USER 1000:1000
