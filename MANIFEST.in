include README.md LICENSE THIRD_PARTY_NOTICES.md
include weyra.example.toml .env.example requirements.txt
recursive-include weyra *.py *.tcss
recursive-include examples *.py
include scripts/verify_source.py scripts/capture_readme.py
recursive-include docs/screenshots *.png
prune benchmarks
prune data
prune tests
prune paper
prune wiki
prune resume
prune .benchmarks
prune .weyra
global-exclude __pycache__ *.py[cod] *.db *.sqlite *.sqlite3 .DS_Store
